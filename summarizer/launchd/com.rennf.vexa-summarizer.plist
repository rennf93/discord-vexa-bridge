<?xml version="1.0" encoding="UTF-8"?>
<!--
  Meeting summarizer launchd agent (runs on the Mac, not the NAS).

  Install:
    1. Fill in the REPLACE_ME values below (AI_API_KEY, VEXA_API_KEY, OBSIDIAN_MCP_TOKEN).
       Never commit the filled-in file — keep it only at ~/Library/LaunchAgents/.
    2. cp summarizer/launchd/com.rennf.vexa-summarizer.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.rennf.vexa-summarizer.plist
    4. Tail logs: tail -f ~/Library/Logs/vexa-summarizer.{out,err}

  One pass per StartInterval seconds; launchd drives repetition. Stop with:
    launchctl unload ~/Library/LaunchAgents/com.rennf.vexa-summarizer.plist

  `uv run --extra summarizer` pulls litellm (kept out of the adapter image). PATH must
  contain wherever uv is installed (homebrew here) — launchd does not load your shell profile.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rennf.vexa-summarizer</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>180</integer>

    <key>WorkingDirectory</key>
    <string>/Users/renzof/Documents/GitHub/ZZZ/discord-vexa-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>uv</string>
        <string>run</string>
        <string>--extra</string>
        <string>summarizer</string>
        <string>python</string>
        <string>-m</string>
        <string>summarizer</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SUMMARIZE_ENABLED</key>
        <string>true</string>

        <key>AI_MODEL</key>
        <string>openai/glm-5.2:cloud</string>
        <key>AI_API_KEY</key>
        <string>not-needed</string>
        <key>AI_BASE_URL</key>
        <string>http://localhost:11434/v1</string>

        <key>VEXA_API_URL</key>
        <string>http://192.168.50.111:8056</string>
        <key>VEXA_API_KEY</key>
        <string>REPLACE_ME</string>

        <key>SUMMARIZE_PLATFORMS</key>
        <string>discord</string>
        <key>MIN_TRANSCRIPT_SECONDS</key>
        <string>30</string>

        <key>OBSIDIAN_ENABLED</key>
        <string>true</string>
        <key>OBSIDIAN_MCP_URL</key>
        <string>http://localhost:8765/mcp</string>
        <key>OBSIDIAN_MCP_TOKEN</key>
        <string>REPLACE_ME</string>
        <key>OBSIDIAN_NOTE_FOLDER</key>
        <string>Meetings</string>
        <key>INCLUDE_TRANSCRIPT</key>
        <string>true</string>

        <key>VEXA_NOTES_ENABLED</key>
        <string>false</string>
        <key>DRY_RUN</key>
        <string>false</string>

        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/renzof/Library/Logs/vexa-summarizer.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/renzof/Library/Logs/vexa-summarizer.err</string>
</dict>
</plist>
